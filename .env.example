# MeGa X Local Core Daemon — Environment Configuration Template
# Copy this file to .env and populate your keys for live LLM & FCM integration.

# AI Model Provider API Keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Mobile Relay & Tailscale Tunnel Security
MEGAX_PORT=4040
MEGAX_RELAY_TOKEN=

# Firebase Cloud Messaging (FCM) Interactive Approval Push Notifications
MEGAX_FCM_WEBHOOK_URL=
MEGAX_FCM_AUTH_TOKEN=
MEGAX_FCM_TARGET=megax-mobile-controller

